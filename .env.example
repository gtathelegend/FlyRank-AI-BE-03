# Copy this file to .env and fill in your real values.
# Never commit .env — it is listed in .gitignore.

# PostgreSQL connection string
# When running via Docker Compose, use: postgresql://postgres:dev@db:5432/tasks
DATABASE_URL=postgresql://postgres:dev@localhost:5432/tasks

# Supabase project credentials (https://supabase.com/dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Redis connection string
# When running via Docker Compose, use: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Port the API listens on (optional, defaults to 8000)
PORT=8000
